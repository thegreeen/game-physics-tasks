{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Quicklaunch: Configure, Build & Run",
            "type": "shell",
            "command": "cmake -S . -B build-vscode && cmake --build build-vscode && (cd build-vscode && ./Template)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}